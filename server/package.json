{
  "name": "monad-kombat-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "compile": "tsx src/compile-contract.ts",
    "deploy:contract": "tsx --env-file=.env src/deploy-contract.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/ws-transport": "^0.16.5",
    "@privy-io/server-auth": "^1.32.5",
    "express": "^5.3.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "solc": "^0.8.37",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
